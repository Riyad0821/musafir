---
import '../styles/global.css';
import SEO, { type Props as SEOProps } from './SEO.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { LOCALES } from '../i18n/ui';

export interface Props {
  seo?: SEOProps;
  containerClass?: string;
}

const { seo = {}, containerClass = 'max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16' } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const currentLocaleInfo = LOCALES[lang];
const t = useTranslations(lang);
---

<!doctype html>
<html lang={currentLocaleInfo.htmlLang} dir={currentLocaleInfo.dir} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Google Fonts Preconnect & Subsets -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- Load Amiri for Arabic, Newsreader & Plus Jakarta Sans for English, Hind Siliguri for Bengali -->
    <link
      href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Hind+Siliguri:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Theme Initialization Script (Zero Flash) -->
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem('musafir-theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>

    <!-- SEO & Metadata -->
    <SEO {...seo} />
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--bg-base)] text-[var(--text-primary)] antialiased selection:bg-[var(--accent-gold-subtle)] selection:text-[var(--accent-gold)]">
    <!-- Accessible Skip to Content Link -->
    <a
      href="#main-content"
      class="skip-link sr-only focus:not-sr-only focus:fixed focus:z-50 focus:px-4 focus:py-2 focus:bg-[var(--accent-gold)] focus:text-white focus:rounded-md focus:shadow-lg focus:outline-none"
    >
      Skip to main content
    </a>

    <!-- Top Site Header -->
    <Header />

    <!-- Main Content Area -->
    <main id="main-content" class={`flex-1 w-full ${containerClass}`} data-pagefind-body>
      <slot />
    </main>

    <!-- Site Footer -->
    <Footer />
  </body>
</html>
