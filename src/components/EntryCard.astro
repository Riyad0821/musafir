---
import TagList from './TagList.astro';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

export interface Props {
  collection: 'ayat' | 'hadith' | 'events' | 'sahaba' | 'writings';
  slug: string;
  data: any;
  featured?: boolean;
}

const { collection, slug, data, featured = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Compute title, subtitle, and URL
let title = '';
let subtitle = '';
let arabicPreview = '';
let excerpt = '';
let referenceOrSource = '';

if (collection === 'ayat') {
  title = `${data.surah} (${data.surahNumber}:${data.ayahFrom}${data.ayahTo ? `-${data.ayahTo}` : ''})`;
  const transSrc = (lang === 'bn' && data.translationSourceBn) ? data.translationSourceBn : data.translationSource;
  subtitle = `${lang === 'bn' ? 'অনুবাদ সূত্র' : 'Translation'}: ${transSrc}`;
  arabicPreview = data.arabic;
  excerpt = (lang === 'bn' && data.translationBn) ? data.translationBn : data.translation;
  referenceOrSource = `${lang === 'bn' ? 'সূরা' : 'Surah'} ${data.surahNumber}, ${lang === 'bn' ? 'আয়াত' : 'Ayah'} ${data.ayahFrom}`;
} else if (collection === 'hadith') {
  title = `${data.collection} #${data.hadithNumber}`;
  subtitle = `${lang === 'bn' ? 'বর্ণনাকারী' : 'Narrated by'} ${data.narrator}`;
  arabicPreview = data.arabic;
  excerpt = (lang === 'bn' && data.translationBn) ? data.translationBn : data.translation;
  referenceOrSource = data.reference;
} else if (collection === 'events') {
  title = (lang === 'bn' && data.titleBn) ? data.titleBn : data.title;
  subtitle = [data.hijriDate, data.gregorianDate, data.era].filter(Boolean).join(' • ');
  excerpt = (lang === 'bn' && data.summaryBn) ? data.summaryBn : data.summary;
  referenceOrSource = data.location || (data.sources && data.sources[0]) || '';
} else if (collection === 'sahaba') {
  title = (lang === 'bn' && data.titleBn) ? data.titleBn : data.title;
  subtitle = `${lang === 'bn' ? 'সাহাবি' : 'Sahabi'}: ${data.sahabi}${data.relatedEvent ? ` • ${data.relatedEvent}` : ''}`;
  excerpt = (lang === 'bn' && data.summaryBn) ? data.summaryBn : data.summary;
  referenceOrSource = (data.sources && data.sources[0]) || '';
} else if (collection === 'writings') {
  title = (lang === 'bn' && data.titleBn) ? data.titleBn : data.title;
  subtitle = `${lang === 'bn' ? 'লেখক' : 'By'} ${data.author}${data.type ? ` (${data.type})` : ''}`;
  excerpt = (lang === 'bn' && data.summaryBn) ? data.summaryBn : (data.summary || '');
  referenceOrSource = data.originalSource || '';
}

const collectionLabels: Record<string, { en: string; bn: string; badgeClass: string }> = {
  ayat: { en: 'Ayah', bn: 'আয়াত', badgeClass: 'bg-emerald-50 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800' },
  hadith: { en: 'Hadith', bn: 'হাদিস', badgeClass: 'bg-amber-50 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300 border-amber-200 dark:border-amber-800' },
  events: { en: 'Event', bn: 'ঘটনা', badgeClass: 'bg-sky-50 text-sky-800 dark:bg-sky-950/60 dark:text-sky-300 border-sky-200 dark:border-sky-800' },
  sahaba: { en: 'Sahaba', bn: 'সাহাবা', badgeClass: 'bg-indigo-50 text-indigo-800 dark:bg-indigo-950/60 dark:text-indigo-300 border-indigo-200 dark:border-indigo-800' },
  writings: { en: 'Writing', bn: 'লেখা', badgeClass: 'bg-rose-50 text-rose-800 dark:bg-rose-950/60 dark:text-rose-300 border-rose-200 dark:border-rose-800' },
};

const badgeInfo = collectionLabels[collection] || { en: collection, bn: collection, badgeClass: 'bg-stone-100 text-stone-800' };
const badgeLabel = lang === 'bn' ? badgeInfo.bn : badgeInfo.en;
const url = getLocalizedPath(`/${collection}/${slug}`, lang);
const formattedDate = data.dateAdded ? new Date(data.dateAdded).toLocaleDateString(lang === 'bn' ? 'bn-BD' : lang === 'en-gb' ? 'en-GB' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
}) : '';
---

<article class={`group relative flex flex-col justify-between p-6 sm:p-7 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] hover:border-[var(--accent-gold)]/60 transition-all duration-300 shadow-[var(--card-shadow)] hover:shadow-lg ${
  featured ? 'ring-1 ring-[var(--accent-gold)]/40 bg-[var(--accent-gold-subtle)]/20' : ''
}`}>
  <div>
    <!-- Top Metadata Bar -->
    <div class="flex items-center justify-between gap-2 mb-3 text-xs">
      <div class="flex items-center gap-2 flex-wrap">
        <span class={`inline-flex items-center px-2 py-0.5 rounded-md font-medium text-[11px] border ${badgeInfo.badgeClass}`}>
          {badgeLabel}
        </span>
        {data.featured && (
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-medium bg-[var(--accent-gold-subtle)] text-[var(--accent-gold)] border border-[var(--accent-gold)]/30">
            {t('featured.badge')}
          </span>
        )}
      </div>
      {formattedDate && (
        <time datetime={data.dateAdded?.toISOString?.()} class="text-[var(--text-muted)] text-[11px]">
          {formattedDate}
        </time>
      )}
    </div>

    <!-- Title -->
    <h3 class="font-serif font-semibold text-lg sm:text-xl text-[var(--text-primary)] group-hover:text-[var(--accent-gold)] transition-colors leading-snug mb-1">
      <a href={url} class="focus:outline-none">
        <span class="absolute inset-0" aria-hidden="true"></span>
        {title}
      </a>
    </h3>

    <!-- Subtitle / Meta -->
    {subtitle && (
      <p class="text-xs text-[var(--text-muted)] mb-3 font-medium">
        {subtitle}
      </p>
    )}

    <!-- Arabic preview if present -->
    {arabicPreview && (
      <div
        dir="rtl"
        lang="ar"
        class="arabic-text text-base sm:text-lg text-[var(--text-primary)]/90 my-3 p-3 rounded-lg bg-[var(--bg-subtle)]/60 line-clamp-2"
      >
        {arabicPreview}
      </div>
    )}

    <!-- Excerpt / Summary -->
    {excerpt && (
      <p class="text-sm text-[var(--text-secondary)] leading-relaxed line-clamp-3 mb-4">
        {excerpt}
      </p>
    )}
  </div>

  <!-- Bottom Details: Reference & Tags -->
  <div class="pt-4 mt-auto border-t border-[var(--border-subtle)] flex flex-col gap-2.5">
    {referenceOrSource && (
      <div class="flex items-center gap-1.5 text-xs text-[var(--text-muted)] truncate">
        <svg class="w-3.5 h-3.5 flex-shrink-0 text-[var(--accent-gold)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
        </svg>
        <span class="truncate">{referenceOrSource}</span>
      </div>
    )}

    {data.tags && data.tags.length > 0 && (
      <div class="relative z-10">
        <TagList tags={data.tags.slice(0, 3)} size="sm" />
      </div>
    )}
  </div>
</article>
