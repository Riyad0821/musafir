---
import TagList from './TagList.astro';
import GeometricPattern from './GeometricPattern.astro';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

export interface Props {
  collection: 'ayat' | 'hadith' | 'events' | 'sahaba' | 'writings';
  slug: string;
  data: any;
  featured?: boolean;
}

const { collection, slug, data, featured = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Compute title, subtitle, and URL
let title = '';
let subtitle = '';
let arabicPreview = '';
let excerpt = '';
let referenceOrSource = '';

if (collection === 'ayat') {
  title = `${data.surah} (${data.surahNumber}:${data.ayahFrom}${data.ayahTo ? `-${data.ayahTo}` : ''})`;
  const transSrc = (lang === 'bn' && data.translationSourceBn) ? data.translationSourceBn : data.translationSource;
  subtitle = `${lang === 'bn' ? 'অনুবাদ সূত্র' : 'Translation'}: ${transSrc}`;
  arabicPreview = data.arabic;
  excerpt = (lang === 'bn' && data.translationBn) ? data.translationBn : data.translation;
  referenceOrSource = `${lang === 'bn' ? 'সূরা' : 'Surah'} ${data.surahNumber}, ${lang === 'bn' ? 'আয়াত' : 'Ayah'} ${data.ayahFrom}`;
} else if (collection === 'hadith') {
  title = `${data.collection} #${data.hadithNumber}`;
  subtitle = `${lang === 'bn' ? 'বর্ণনাকারী' : 'Narrated by'} ${data.narrator}`;
  arabicPreview = data.arabic;
  excerpt = (lang === 'bn' && data.translationBn) ? data.translationBn : data.translation;
  referenceOrSource = data.reference;
} else if (collection === 'events') {
  title = (lang === 'bn' && data.titleBn) ? data.titleBn : data.title;
  subtitle = [data.hijriDate, data.gregorianDate, data.era].filter(Boolean).join(' • ');
  excerpt = (lang === 'bn' && data.summaryBn) ? data.summaryBn : data.summary;
  referenceOrSource = data.location || (data.sources && data.sources[0]) || '';
} else if (collection === 'sahaba') {
  title = (lang === 'bn' && data.titleBn) ? data.titleBn : data.title;
  subtitle = `${lang === 'bn' ? 'সাহাবি' : 'Sahabi'}: ${data.sahabi}${data.relatedEvent ? ` • ${data.relatedEvent}` : ''}`;
  excerpt = (lang === 'bn' && data.summaryBn) ? data.summaryBn : data.summary;
  referenceOrSource = (data.sources && data.sources[0]) || '';
} else if (collection === 'writings') {
  title = (lang === 'bn' && data.titleBn) ? data.titleBn : data.title;
  subtitle = `${lang === 'bn' ? 'লেখক' : 'By'} ${data.author}${data.type ? ` (${data.type})` : ''}`;
  excerpt = (lang === 'bn' && data.summaryBn) ? data.summaryBn : (data.summary || '');
  referenceOrSource = data.originalSource || '';
}

// Harmonious editorial badges adhering to the botanical/gold design system
const collectionLabels: Record<string, { en: string; bn: string; badgeClass: string }> = {
  ayat: {
    en: 'Ayah',
    bn: 'আয়াত',
    badgeClass: 'bg-[var(--primary-accent)]/10 text-[var(--primary-accent)] dark:text-[#88B399] border-[var(--primary-accent)]/20',
  },
  hadith: {
    en: 'Hadith',
    bn: 'হাদিস',
    badgeClass: 'bg-[var(--accent-gold)]/10 text-[var(--accent-gold)] dark:text-[#CBB27A] border-[var(--accent-gold)]/25',
  },
  sahaba: {
    en: 'Sahaba',
    bn: 'সাহাবা',
    badgeClass: 'bg-[#436450]/10 text-[#436450] dark:text-[#90BAA0] border-[#436450]/20',
  },
  events: {
    en: 'Event',
    bn: 'ঘটনা',
    badgeClass: 'bg-[#5B6358]/10 text-[#5B6358] dark:text-[#A7B3A3] border-[#5B6358]/20',
  },
  writings: {
    en: 'Writing',
    bn: 'লেখা',
    badgeClass: 'bg-[#7A5B3D]/10 text-[#7A5B3D] dark:text-[#CBB295] border-[#7A5B3D]/20',
  },
};

const badgeInfo = collectionLabels[collection] || { en: collection, bn: collection, badgeClass: 'bg-[var(--bg-subtle)] text-[var(--text-secondary)] border-[var(--border-subtle)]' };
const badgeLabel = lang === 'bn' ? badgeInfo.bn : badgeInfo.en;
const url = getLocalizedPath(`/${collection}/${slug}`, lang);
const formattedDate = data.dateAdded ? new Date(data.dateAdded).toLocaleDateString(lang === 'bn' ? 'bn-BD' : lang === 'en-gb' ? 'en-GB' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
}) : '';
---

<article class={`group relative flex flex-col justify-between p-6 sm:p-7 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] hover:border-[var(--accent-gold)]/50 transition-all duration-300 shadow-[var(--card-shadow)] hover:shadow-[var(--card-shadow-hover)] hover:-translate-y-0.5 ${
  featured ? 'ring-1 ring-[var(--accent-gold)]/35 bg-gradient-to-b from-[var(--accent-gold-subtle)]/25 to-[var(--bg-surface)]' : ''
}`}>
  <!-- Decorative corner motif on featured card -->
  {featured && (
    <div class="absolute top-2 right-2 pointer-events-none select-none">
      <GeometricPattern variant="corner" class="rotate-90" />
    </div>
  )}

  <div>
    <!-- Top Metadata Bar -->
    <div class="flex items-center justify-between gap-2 mb-3.5 text-xs">
      <div class="flex items-center gap-2 flex-wrap">
        <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full font-medium text-[11px] border tracking-wide ${badgeInfo.badgeClass}`}>
          {badgeLabel}
        </span>
        {data.featured && (
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium bg-[var(--accent-gold-subtle)] text-[var(--accent-gold)] border border-[var(--accent-gold)]/30">
            ★ {t('featured.badge')}
          </span>
        )}
      </div>
      {formattedDate && (
        <time datetime={data.dateAdded?.toISOString?.()} class="text-[var(--text-muted)] text-[11px] font-sans">
          {formattedDate}
        </time>
      )}
    </div>

    <!-- Title with link -->
    <h3 class="font-serif font-semibold text-lg sm:text-xl text-[var(--text-primary)] group-hover:text-[var(--primary-accent)] dark:group-hover:text-[var(--accent-gold)] transition-colors leading-snug mb-1.5">
      <a href={url} class="focus:outline-none focus-visible:underline">
        <span class="absolute inset-0" aria-hidden="true"></span>
        {title}
      </a>
    </h3>

    <!-- Subtitle / Meta Context -->
    {subtitle && (
      <p class="text-xs text-[var(--text-muted)] mb-3 font-medium">
        {subtitle}
      </p>
    )}

    <!-- Arabic preview with genuine RTL rendering -->
    {arabicPreview && (
      <div
        dir="rtl"
        lang="ar"
        class="arabic-text text-base sm:text-lg text-[var(--text-primary)]/90 my-3.5 p-3.5 rounded-xl bg-[var(--bg-subtle)]/50 border border-[var(--border-subtle)]/60 line-clamp-2 leading-[2.1]"
      >
        {arabicPreview}
      </div>
    )}

    <!-- Excerpt / Reflection Summary -->
    {excerpt && (
      <p class="text-sm text-[var(--text-secondary)] leading-relaxed line-clamp-3 mb-4">
        {excerpt}
      </p>
    )}
  </div>

  <!-- Bottom Details: Reference & Tags -->
  <div class="pt-4 mt-auto border-t border-[var(--border-subtle)]/75 flex flex-col gap-2.5">
    {referenceOrSource && (
      <div class="flex items-center gap-1.5 text-xs text-[var(--text-muted)] truncate">
        <svg class="w-3.5 h-3.5 flex-shrink-0 text-[var(--accent-gold)] opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
        </svg>
        <span class="truncate">{referenceOrSource}</span>
      </div>
    )}

    {data.tags && data.tags.length > 0 && (
      <div class="relative z-10 pt-0.5">
        <TagList tags={data.tags.slice(0, 3)} size="sm" />
      </div>
    )}
  </div>
</article>
