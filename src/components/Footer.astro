---
import Logo from './Logo.astro';
import { SITE_CONFIG } from '../config';

const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-[var(--border-subtle)] bg-[var(--bg-subtle)]/40 text-sm transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 lg:gap-12 mb-12">
      <!-- Col 1: Brand & Tagline -->
      <div class="md:col-span-2 space-y-4">
        <Logo showTagline={true} />
        <p class="text-[var(--text-secondary)] text-sm leading-relaxed max-w-md">
          {SITE_CONFIG.tagline}
        </p>
        <p class="text-[var(--text-muted)] text-xs leading-relaxed max-w-md border-l-2 border-[var(--accent-gold)] pl-3">
          <strong>A traveler's note:</strong> Musafir is a personal, read-only collection of reflections and verified Islamic sources. It does not issue legal rulings (fatawa) or replace scholarly counsel.
        </p>
      </div>

      <!-- Col 2: Collections -->
      <div>
        <h2 class="text-xs font-semibold uppercase tracking-wider text-[var(--text-primary)] mb-3">
          Collections
        </h2>
        <ul class="space-y-2 text-[var(--text-secondary)]">
          <li><a href="/ayat" class="hover:text-[var(--accent-gold)] transition-colors">Quranic Ayat</a></li>
          <li><a href="/hadith" class="hover:text-[var(--accent-gold)] transition-colors">Prophetic Hadith</a></li>
          <li><a href="/events" class="hover:text-[var(--accent-gold)] transition-colors">Islamic Events</a></li>
          <li><a href="/sahaba" class="hover:text-[var(--accent-gold)] transition-colors">Lives of the Sahaba</a></li>
          <li><a href="/writings" class="hover:text-[var(--accent-gold)] transition-colors">Writings & Reflections</a></li>
        </ul>
      </div>

      <!-- Col 3: Navigation & Feeds -->
      <div>
        <h2 class="text-xs font-semibold uppercase tracking-wider text-[var(--text-primary)] mb-3">
          Explore & Connect
        </h2>
        <ul class="space-y-2 text-[var(--text-secondary)]">
          <li><a href="/tags" class="hover:text-[var(--accent-gold)] transition-colors">Tag Directory</a></li>
          <li><a href="/about" class="hover:text-[var(--accent-gold)] transition-colors">About & Sourcing Policy</a></li>
          <li><a href="/search" class="hover:text-[var(--accent-gold)] transition-colors">Full-Text Search</a></li>
          <li>
            <a href="/rss.xml" class="inline-flex items-center gap-1.5 hover:text-[var(--accent-gold)] transition-colors">
              <svg class="w-3.5 h-3.5 text-amber-500" fill="currentColor" viewBox="0 0 24 24">
                <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"/>
              </svg>
              RSS Feed
            </a>
          </li>
          <li>
            <a href="/sitemap-index.xml" class="hover:text-[var(--accent-gold)] transition-colors">
              Sitemap
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-[var(--border-subtle)] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[var(--text-muted)]">
      <p>© {currentYear} {SITE_CONFIG.name}. Built with Astro & Tailwind CSS.</p>
      
      <div class="flex items-center gap-4">
        <a href="#top" class="hover:text-[var(--text-primary)] transition-colors inline-flex items-center gap-1" title="Back to top of page">
          Back to top
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
