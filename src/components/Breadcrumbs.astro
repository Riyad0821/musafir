---
export interface BreadcrumbItem {
  name: string;
  url: string;
}

export interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items = [], class: className = '' } = Astro.props;
---

<nav aria-label="Breadcrumb" class={`flex items-center text-xs text-[var(--text-muted)] py-3 ${className}`}>
  <ol class="flex items-center flex-wrap gap-1.5">
    <li>
      <a href="/" class="hover:text-[var(--accent-gold)] transition-colors inline-flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
        </svg>
        <span>Home</span>
      </a>
    </li>

    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li class="flex items-center gap-1.5">
          <svg class="w-3 h-3 text-[var(--border-strong)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
          {isLast ? (
            <span class="font-medium text-[var(--text-primary)] truncate max-w-[200px] sm:max-w-xs" aria-current="page">
              {item.name}
            </span>
          ) : (
            <a href={item.url} class="hover:text-[var(--accent-gold)] transition-colors">
              {item.name}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
