---
import tagsData from '../data/tags.json';
import { getLangFromUrl, getLocalizedPath } from '../i18n/utils';

export interface Props {
  tags: string[];
  class?: string;
  size?: 'sm' | 'md';
}

const { tags = [], class: className = '', size = 'sm' } = Astro.props;
const lang = getLangFromUrl(Astro.url);

const tagRecord = tagsData as Record<string, { name: string; nameBn?: string; description: string; descriptionBn?: string }>;

const sizeClasses = {
  sm: 'text-xs px-2.5 py-0.5',
  md: 'text-xs sm:text-sm px-3.5 py-1',
}[size];
---

{tags && tags.length > 0 && (
  <div class={`flex flex-wrap items-center gap-1.5 ${className}`} aria-label="Tags">
    {tags.map((tag) => {
      const item = tagRecord[tag];
      const displayName = lang === 'bn' ? (item?.nameBn || item?.name || tag) : (item?.name || tag.replace(/-/g, ' '));
      const targetUrl = getLocalizedPath(`/tags/${tag}`, lang);
      return (
        <a
          href={targetUrl}
          class={`inline-flex items-center gap-1 rounded-full font-medium transition-colors bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:bg-[var(--accent-gold-subtle)] hover:text-[var(--accent-gold)] hover:border-[var(--accent-gold)]/40 border border-[var(--border-subtle)] ${sizeClasses}`}
        >
          <span class="text-[var(--accent-gold)] opacity-70">#</span>
          <span>{displayName}</span>
        </a>
      );
    })}
  </div>
)}
