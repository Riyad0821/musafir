---
export interface Props {
  variant?: 'hero-backdrop' | 'rosette' | 'divider' | 'corner';
  class?: string;
  size?: number;
  animate?: boolean;
}

const {
  variant = 'rosette',
  class: className = '',
  size = 48,
  animate = false,
} = Astro.props;
---

{variant === 'hero-backdrop' && (
  <div class={`absolute inset-0 overflow-hidden pointer-events-none select-none ${className}`} aria-hidden="true">
    <svg
      class="w-full h-full opacity-[0.035] dark:opacity-[0.045] text-[var(--accent-gold)]"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 800 800"
      fill="none"
      stroke="currentColor"
      stroke-width="1"
    >
      <defs>
        <!-- Authentic 8-fold Islamic Geometric Rosette Pattern Tile -->
        <pattern id="islamic-girih-pattern" width="160" height="160" patternUnits="userSpaceOnUse">
          <!-- Center 8-point star -->
          <polygon points="80,50 88,72 110,80 88,88 80,110 72,88 50,80 72,72" />
          <!-- Interlocking octagons and connecting geometry -->
          <rect x="52" y="52" width="56" height="56" stroke-dasharray="2 2" />
          <line x1="0" y1="0" x2="52" y2="52" />
          <line x1="160" y1="0" x2="108" y2="52" />
          <line x1="160" y1="160" x2="108" y2="108" />
          <line x1="0" y1="160" x2="52" y2="108" />
          
          <polygon points="0,20 20,0 30,10 10,30" />
          <polygon points="160,20 140,0 130,10 150,30" />
          <polygon points="160,140 140,160 130,150 150,130" />
          <polygon points="0,140 20,160 30,150 10,130" />
          
          <circle cx="80" cy="80" r="42" stroke-width="0.75" />
          <circle cx="80" cy="80" r="65" stroke-dasharray="1 3" stroke-width="0.5" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#islamic-girih-pattern)" />
    </svg>
  </div>
)}

{variant === 'rosette' && (
  <svg
    class={`text-[var(--accent-gold)] opacity-70 flex-shrink-0 ${animate ? 'animate-spin-meditative' : ''} ${className}`}
    width={size}
    height={size}
    viewBox="0 0 32 32"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <!-- Elegant 8-fold Islamic Rosette Symbol -->
    <path
      d="M16 2L19.5 9.5L27 6L23.5 13.5L30 16L23.5 18.5L27 26L19.5 22.5L16 30L12.5 22.5L5 26L8.5 18.5L2 16L8.5 13.5L5 6L12.5 9.5L16 2Z"
      stroke="currentColor"
      stroke-width="1.2"
      stroke-linejoin="round"
    />
    <circle cx="16" cy="16" r="4" stroke="currentColor" stroke-width="1" />
    <circle cx="16" cy="16" r="1.5" fill="currentColor" />
  </svg>
)}

{variant === 'divider' && (
  <div class={`flex items-center justify-center gap-3 my-10 text-[var(--accent-gold)] select-none pointer-events-none ${className}`} aria-hidden="true">
    <div class="h-px flex-1 bg-gradient-to-r from-transparent via-[var(--border-subtle)] to-transparent"></div>
    <svg class="w-5 h-5 opacity-60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
      <path d="M12 2L14.5 7.5L20 5L17.5 10.5L22 12L17.5 13.5L20 19L14.5 16.5L12 22L9.5 16.5L4 19L6.5 13.5L2 12L6.5 10.5L4 5L9.5 7.5L12 2Z" />
      <circle cx="12" cy="12" r="2.5" fill="currentColor" fill-opacity="0.3" />
    </svg>
    <div class="h-px flex-1 bg-gradient-to-r from-transparent via-[var(--border-subtle)] to-transparent"></div>
  </div>
)}

{variant === 'corner' && (
  <svg
    class={`text-[var(--accent-gold)] pointer-events-none select-none opacity-20 ${className}`}
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path d="M2 12V2H12" stroke="currentColor" stroke-width="1.5" />
    <path d="M5 8V5H8" stroke="currentColor" stroke-width="1" opacity="0.6" />
    <circle cx="5" cy="5" r="1" fill="currentColor" />
  </svg>
)}
