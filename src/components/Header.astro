---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguagePicker from './LanguagePicker.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath, stripLocaleFromPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const pathname = Astro.url.pathname;
const cleanPath = stripLocaleFromPath(pathname);

const navLinks = [
  { href: getLocalizedPath('/ayat', lang), raw: '/ayat', label: t('nav.ayat') },
  { href: getLocalizedPath('/hadith', lang), raw: '/hadith', label: t('nav.hadith') },
  { href: getLocalizedPath('/sahaba', lang), raw: '/sahaba', label: t('nav.sahaba') },
  { href: getLocalizedPath('/events', lang), raw: '/events', label: t('nav.events') },
  { href: getLocalizedPath('/writings', lang), raw: '/writings', label: t('nav.writings') },
  { href: getLocalizedPath('/tags', lang), raw: '/tags', label: t('nav.tags') },
  { href: getLocalizedPath('/about', lang), raw: '/about', label: t('nav.about') },
];

const homeHref = getLocalizedPath('/', lang);
const searchHref = getLocalizedPath('/search', lang);

const isLinkActive = (raw: string) => {
  if (raw === '/' && cleanPath === '/') return true;
  if (raw !== '/' && cleanPath.startsWith(raw)) return true;
  return false;
};
---

<header class="sticky top-0 z-40 w-full backdrop-blur-md bg-[var(--bg-base)]/90 border-b border-[var(--border-subtle)] transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    <!-- Brand Logo -->
    <Logo showTagline={false} />

    <!-- Desktop Nav Links -->
    <nav class="hidden lg:flex items-center gap-1 font-medium text-sm" aria-label="Main navigation">
      {navLinks.map((link) => {
        const active = isLinkActive(link.raw);
        return (
          <a
            href={link.href}
            class={`px-3 py-1.5 rounded-lg text-sm transition-all duration-200 ${
              active
                ? 'text-[var(--primary-accent)] dark:text-[var(--accent-gold)] font-semibold bg-[var(--accent-gold-subtle)]'
                : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-subtle)]/60'
            }`}
            aria-current={active ? 'page' : undefined}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-1.5 sm:gap-2">
      <!-- Search Link Button -->
      <a
        href={searchHref}
        class={`p-2 rounded-lg text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent-gold)] ${
          cleanPath === '/search' ? 'text-[var(--primary-accent)] dark:text-[var(--accent-gold)] bg-[var(--accent-gold-subtle)]' : ''
        }`}
        aria-label={t('nav.search')}
        title={t('search.title')}
      >
        <svg class="w-4 h-4 sm:w-4.5 sm:h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </a>

      <!-- Language Switcher -->
      <LanguagePicker />

      <!-- Theme Switcher -->
      <ThemeToggle />

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="lg:hidden p-2 rounded-lg text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent-gold)]"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="hamburger-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg id="close-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer / Dropdown -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden border-b border-[var(--border-subtle)] bg-[var(--bg-surface)] px-4 pt-3 pb-6 transition-all shadow-md"
  >
    <nav class="flex flex-col gap-1" aria-label="Mobile navigation">
      <a
        href={homeHref}
        class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors ${
          cleanPath === '/'
            ? 'text-[var(--primary-accent)] dark:text-[var(--accent-gold)] bg-[var(--accent-gold-subtle)] font-semibold'
            : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-subtle)]'
        }`}
      >
        {t('nav.home')}
      </a>
      {navLinks.map((link) => {
        const active = isLinkActive(link.raw);
        return (
          <a
            href={link.href}
            class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors ${
              active
                ? 'text-[var(--primary-accent)] dark:text-[var(--accent-gold)] bg-[var(--accent-gold-subtle)] font-semibold'
                : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-subtle)]'
            }`}
            aria-current={active ? 'page' : undefined}
          >
            {link.label}
          </a>
        );
      })}
      <a
        href={searchHref}
        class={`px-3 py-2 rounded-lg text-sm font-medium flex items-center gap-2 transition-colors ${
          cleanPath === '/search'
            ? 'text-[var(--primary-accent)] dark:text-[var(--accent-gold)] bg-[var(--accent-gold-subtle)] font-semibold'
            : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-subtle)]'
        }`}
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        {t('nav.search')}
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    if (!btn || !menu) return;

    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      if (hamburgerIcon && closeIcon) {
        hamburgerIcon.classList.toggle('hidden');
        closeIcon.classList.toggle('hidden');
      }
    });

    document.addEventListener('click', (e) => {
      if (!btn.contains(e.target) && !menu.contains(e.target) && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        if (hamburgerIcon && closeIcon) {
          hamburgerIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
        }
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        if (hamburgerIcon && closeIcon) {
          hamburgerIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
        }
        btn.focus();
      }
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
