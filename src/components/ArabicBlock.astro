---
import GeometricPattern from './GeometricPattern.astro';

export interface Props {
  text?: string;
  sourceLabel?: string;
  class?: string;
  size?: 'normal' | 'large' | 'featured';
}

const {
  text,
  sourceLabel,
  class: className = '',
  size = 'normal',
} = Astro.props;

const sizeClasses = {
  normal: 'text-2xl md:text-3xl leading-[2.2]',
  large: 'text-3xl md:text-4xl leading-[2.3]',
  featured: 'text-3xl sm:text-4xl md:text-5xl leading-[2.4]',
}[size];
---

<div class={`relative my-6 p-6 sm:p-8 md:p-10 rounded-2xl bg-[var(--bg-subtle)]/45 border border-[var(--border-subtle)] shadow-[var(--card-shadow)] transition-colors overflow-hidden ${className}`}>
  <!-- Subtle decorative Islamic corner motifs -->
  <div class="absolute top-2 left-2 pointer-events-none select-none">
    <GeometricPattern variant="corner" class="opacity-25" />
  </div>
  <div class="absolute bottom-2 right-2 pointer-events-none select-none rotate-180">
    <GeometricPattern variant="corner" class="opacity-25" />
  </div>

  <!-- Arabic text container with explicit RTL and lang="ar" -->
  <blockquote
    dir="rtl"
    lang="ar"
    class={`arabic-text ${sizeClasses} text-[var(--text-primary)] font-normal text-right overflow-visible tracking-normal selection:bg-[var(--accent-gold-subtle)] selection:text-[var(--accent-gold)]`}
  >
    {text ? text : <slot />}
  </blockquote>

  {sourceLabel && (
    <div class="mt-6 pt-4 border-t border-[var(--border-subtle)]/70 flex items-center justify-between text-xs text-[var(--text-muted)]">
      <span class="font-serif italic text-sm">{sourceLabel}</span>
      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] tracking-wider uppercase font-semibold bg-[var(--accent-gold-subtle)] text-[var(--accent-gold)] border border-[var(--accent-gold)]/30">
        النَّصُّ الأَصْلِيُّ • Original Script
      </span>
    </div>
  )}
</div>
