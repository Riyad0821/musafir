---
export interface Props {
  text?: string;
  sourceLabel?: string;
  class?: string;
  size?: 'normal' | 'large' | 'featured';
}

const {
  text,
  sourceLabel,
  class: className = '',
  size = 'normal',
} = Astro.props;

const sizeClasses = {
  normal: 'text-2xl md:text-3xl leading-[2.2]',
  large: 'text-3xl md:text-4xl leading-[2.3]',
  featured: 'text-3xl md:text-5xl leading-[2.4]',
}[size];
---

<div class={`relative my-6 p-6 md:p-8 rounded-2xl bg-[var(--bg-subtle)]/50 border border-[var(--border-subtle)] transition-colors ${className}`}>
  <!-- Subtle decorative Islamic motif icon in background corner -->
  <div class="absolute top-3 left-3 text-[var(--accent-gold)] opacity-15 pointer-events-none select-none" aria-hidden="true">
    <svg class="w-10 h-10" viewBox="0 0 40 40" fill="currentColor">
      <path d="M20 0L24 16L40 20L24 24L20 40L16 24L0 20L16 16L20 0Z" />
    </svg>
  </div>

  <!-- Arabic text container with explicit RTL and lang="ar" -->
  <blockquote
    dir="rtl"
    lang="ar"
    class={`arabic-text ${sizeClasses} text-[var(--text-primary)] font-normal text-right overflow-visible tracking-normal selection:bg-[var(--accent-gold-subtle)]`}
  >
    {text ? text : <slot />}
  </blockquote>

  {sourceLabel && (
    <div class="mt-4 pt-3 border-t border-[var(--border-subtle)]/60 flex items-center justify-between text-xs text-[var(--text-muted)]">
      <span class="font-serif italic">{sourceLabel}</span>
      <span class="text-[10px] tracking-wider uppercase font-semibold text-[var(--accent-gold)]">Original Text</span>
    </div>
  )}
</div>
