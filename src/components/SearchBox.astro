---
export interface Props {
  placeholder?: string;
  autofocus?: boolean;
}

const {
  placeholder = "Search ayat, hadith, events, sahaba, and reflections...",
  autofocus = true,
} = Astro.props;
---

<div class="w-full max-w-3xl mx-auto">
  <!-- Search Input Bar -->
  <div class="relative">
    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-[var(--accent-gold)]">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
    </div>

    <input
      type="search"
      id="pagefind-search-input"
      class="w-full pl-12 pr-12 py-3.5 sm:py-4 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] focus:border-[var(--accent-gold)] focus:ring-2 focus:ring-[var(--accent-gold)]/30 text-[var(--text-primary)] placeholder-[var(--text-muted)] text-base sm:text-lg transition-all shadow-[var(--card-shadow)] outline-none"
      placeholder={placeholder}
      autocomplete="off"
      autofocus={autofocus}
      aria-label="Search through Musafir collections"
    />

    <!-- Keyboard shortcut hint -->
    <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
      <kbd class="hidden sm:inline-block px-2 py-0.5 text-xs font-semibold text-[var(--text-muted)] bg-[var(--bg-subtle)] border border-[var(--border-subtle)] rounded-md shadow-xs">
        /
      </kbd>
    </div>
  </div>

  <!-- Search Status & Count -->
  <div id="search-status" class="mt-4 text-xs sm:text-sm text-[var(--text-muted)] min-h-[1.5rem] flex items-center justify-between px-1">
    <span id="search-count"></span>
    <span id="search-hint" class="italic opacity-80">Tip: Search by Arabic, English keyword, surah, narrator, or tag</span>
  </div>

  <!-- Search Results Container -->
  <div id="search-results" class="mt-6 space-y-4" aria-live="polite">
    <!-- Results dynamically rendered here -->
  </div>

  <!-- Dev mode fallback message if pagefind not yet generated -->
  <div id="dev-notice" class="hidden mt-8 p-6 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-amber-800 dark:text-amber-200 text-sm">
    <p class="font-semibold mb-1">Search index notice:</p>
    <p>Pagefind creates its client search index during the production build step (<code>npm run build</code>). If you are running <code>npm run dev</code>, run <code>npm run build</code> once to generate the <code>dist/pagefind/</code> index.</p>
  </div>
</div>

<script is:inline>
  let pagefindInstance = null;
  let debounceTimer = null;

  async function loadPagefind() {
    if (pagefindInstance) return pagefindInstance;
    try {
      // Dynamic import of pagefind index
      const pf = await import('/pagefind/pagefind.js');
      await pf.init();
      pagefindInstance = pf;
      return pf;
    } catch (e) {
      console.info('Pagefind not found (normal in local dev before build):', e.message);
      const devNotice = document.getElementById('dev-notice');
      if (devNotice) devNotice.classList.remove('hidden');
      return null;
    }
  }

  async function performSearch(query) {
    const resultsContainer = document.getElementById('search-results');
    const countContainer = document.getElementById('search-count');
    const trimmed = query.trim();

    if (!trimmed) {
      if (resultsContainer) resultsContainer.innerHTML = '';
      if (countContainer) countContainer.textContent = '';
      return;
    }

    const pf = await loadPagefind();
    if (!pf) {
      if (countContainer) countContainer.textContent = 'Pagefind index ready after running `npm run build`';
      return;
    }

    if (countContainer) countContainer.textContent = 'Searching...';

    const searchResponse = await pf.search(trimmed);
    const results = searchResponse.results || [];

    if (countContainer) {
      countContainer.textContent = `Found ${results.length} ${results.length === 1 ? 'entry' : 'entries'}`;
    }

    if (results.length === 0) {
      if (resultsContainer) {
        resultsContainer.innerHTML = `
          <div class="text-center py-12 p-8 rounded-2xl bg-[var(--bg-subtle)]/40 border border-[var(--border-subtle)]">
            <p class="text-base font-serif font-medium text-[var(--text-primary)]">No matching reflections found</p>
            <p class="text-xs text-[var(--text-muted)] mt-1">Try another term, root word, or broader concept.</p>
          </div>
        `;
      }
      return;
    }

    // Load first 15 results
    const loadedData = await Promise.all(results.slice(0, 15).map(r => r.data()));

    if (resultsContainer) {
      resultsContainer.innerHTML = loadedData.map(item => `
        <article class="p-5 sm:p-6 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] hover:border-[var(--accent-gold)]/50 transition-all duration-300 shadow-[var(--card-shadow)] hover:shadow-[var(--card-shadow-hover)] hover:-translate-y-0.5">
          <a href="${item.url}" class="group block focus:outline-none focus-visible:underline">
            <h3 class="font-serif text-lg font-semibold text-[var(--text-primary)] group-hover:text-[var(--primary-accent)] dark:group-hover:text-[var(--accent-gold)] transition-colors mb-2">
              ${item.meta?.title || 'Untitled Entry'}
            </h3>
            <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed line-clamp-3">
              ${item.excerpt}
            </p>
            <div class="mt-3 flex items-center gap-1.5 text-xs text-[var(--primary-accent)] dark:text-[var(--accent-gold)] font-medium">
              <span>Read reflection</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </a>
        </article>
      `).join('');
    }
  }

  function initSearchUI() {
    const input = document.getElementById('pagefind-search-input');
    if (!input) return;

    // Preload pagefind on focus or hover
    input.addEventListener('focus', loadPagefind, { once: true });

    // Keyboard shortcut '/' to focus
    window.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== input) {
        e.preventDefault();
        input.focus();
      }
    });

    input.addEventListener('input', (e) => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        performSearch(e.target.value);
      }, 200);
    });

    // Check URL query parameters (e.g. ?q=sabr)
    const urlParams = new URLSearchParams(window.location.search);
    const q = urlParams.get('q');
    if (q) {
      input.value = q;
      performSearch(q);
    }
  }

  initSearchUI();
  document.addEventListener('astro:after-swap', initSearchUI);
</script>
