---
import Layout from '../../components/Layout.astro';
import EntryCard from '../../components/EntryCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Pagination from '../../components/Pagination.astro';
import { getCollection } from 'astro:content';
import tagsData from '../../data/tags.json';

const allAyat = await getCollection('ayat', ({ data }) => !data.draft);
allAyat.sort((a, b) => new Date(b.data.dateAdded).getTime() - new Date(a.data.dateAdded).getTime());

// Collect all unique tags in this collection
const uniqueTags = Array.from(new Set(allAyat.flatMap((item) => item.data.tags || [])));
const tagRecord = tagsData as Record<string, { name: string; description: string }>;

const pageSize = 12;
const totalPages = Math.ceil(allAyat.length / pageSize) || 1;
const currentPage = 1;
const paginatedEntries = allAyat.slice(0, pageSize);
---

<Layout
  seo={{
    title: 'Quranic Ayat — Revelation & Remembrance',
    description: 'A curated selection of Quranic ayat with verified Arabic script, translations, and personal reflections.',
    breadcrumbs: [
      { name: 'Quranic Ayat', url: '/ayat' }
    ],
  }}
>
  <Breadcrumbs items={[{ name: 'Ayat', url: '/ayat' }]} />

  <!-- Page Header -->
  <header class="py-8 md:py-12 border-b border-[var(--border-subtle)] mb-8">
    <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[var(--accent-gold)] mb-3">
      <span>Collection</span>
      <span>•</span>
      <span>{allAyat.length} {allAyat.length === 1 ? 'Entry' : 'Entries'}</span>
    </div>

    <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold text-[var(--text-primary)]">
      Quranic Ayat
    </h1>

    <p class="mt-3 text-base sm:text-lg text-[var(--text-secondary)] max-w-2xl leading-relaxed">
      Sacred verses of revelation, divine solace, and timeless guidance. Each entry preserves the authentic Uthmani text alongside verified translations.
    </p>

    <!-- Tag Filter Bar -->
    {uniqueTags.length > 0 && (
      <div class="mt-6 flex flex-wrap items-center gap-2">
        <span class="text-xs text-[var(--text-muted)] font-medium mr-1">Filter by tag:</span>
        {uniqueTags.map((tag) => (
          <a
            href={`/tags/${tag}`}
            class="text-xs px-3 py-1 rounded-full bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:bg-[var(--accent-gold-subtle)] hover:text-[var(--accent-gold)] border border-[var(--border-subtle)] transition-colors"
          >
            #{tagRecord[tag]?.name || tag}
          </a>
        ))}
      </div>
    )}
  </header>

  <!-- Entries Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {paginatedEntries.map((entry) => (
      <EntryCard
        collection="ayat"
        slug={entry.id}
        data={entry.data}
      />
    ))}
  </div>

  <!-- Pagination Controls -->
  <Pagination
    currentPage={currentPage}
    lastPage={totalPages}
    nextUrl={totalPages > 1 ? '/ayat/page/2' : undefined}
    baseUrl="/ayat"
  />
</Layout>
